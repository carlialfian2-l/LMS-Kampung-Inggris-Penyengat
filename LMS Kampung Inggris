/* ============ routing + guards ============ */
const PUBLIC=['landing','programs','program','login','signup'];
let R={name:'landing',p:{}};
function homeOf(u){return u.role==='tutor'?'t-dash':'s-dash'}
function go(name,p={}){
  const u=me();
  if(!PUBLIC.includes(name)){
    if(!u){db.pending=db.pending;R={name:'login',p:{}};return finish()}
    if(name!=='role'&&!u.role){R={name:'role',p:{}};return finish()}
    if(name.startsWith('s-')&&u.role!=='student'){toast('Access denied: that page is for students.');R={name:homeOf(u),p:{}};return finish()}
    if(name.startsWith('t-')&&u.role!=='tutor'){toast('Access denied: that page is for tutors.');R={name:homeOf(u),p:{}};return finish()}
  }
  R={name,p};finish();
}
function finish(){closeMenu();render();window.scrollTo(0,0)}
function toast(m){const t=document.getElementById('toast');t.textContent=m;t.hidden=false;clearTimeout(toast.t);toast.t=setTimeout(()=>{t.hidden=true},3200)}
function closeMenu(){const s=document.querySelector('.side'),c=document.querySelector('.scrim');s&&s.classList.remove('open');c&&c.classList.remove('on')}
function afterAuth(u){
