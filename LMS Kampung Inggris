function classCard(c,u){
  const ms=visibleMats(c.id),as=classAssigns(c.id),pg=classProg(u.id,c.id);
  return `<article class="card stack">
   <div class="rt"><span class="mi">${ic('book')}</span><div class="grow"><h3 style="font-size:19px">${esc(c.name)}</h3><div class="meta">Tutor: ${esc(tutorName(c))}</div></div></div>
   <div class="meta">${ic('clock',14)} ${esc(c.schedule)}</div>
   <div><div style="display:flex;justify-content:space-between"><span class="meta">Progress</span><span class="pct">${pg}%</span></div>${bar(pg)}</div>
   <div class="meta">Materials: <b class="tnum">${ms.length}</b> · Assignments: <b class="tnum">${as.length}</b></div>
   <button class="btn prim" data-go="s-class" data-p='${JSON.stringify({id:c.id})}'>Open Class</button></article>`;
}
function matRow(m,sid,showClass){
  const done=isDone(sid,m.id);
  return `<article class="cardrow"><div class="mi t-${m.type}">${ic(TI[m.type])}</div>
   <div class="grow"><div class="rt"><h4>${esc(m.title)}</h4>${badge(TL[m.type],'info')}${done?badge('Completed','good'):''}</div>
   <p class="muted" style="margin-top:2px">${esc(m.description)}</p>
   <p class="meta" style="margin-top:4px">Uploaded ${fmtD(m.date,1)} · Tutor ${esc(first(usr(m.tutorId).name))}${showClass?` · ${esc(cls(m.classId).name)}`:''}</p></div>
   <div class="acts"><button class="btn sm" data-act="view-mat" data-id="${m.id}">${ic('eye',15)}View</button><button class="btn sm" data-act="dl-mat" data-id="${m.id}">${ic('download',15)}Download</button>
   <button class="btn sm ${done?'':'prim'}" data-act="complete-mat" data-id="${m.id}">${done?'Undo complete':'Mark complete'}</button></div></article>`;
}
function dueChip(a,st){
  if(['submitted','graded'].includes(st))return '';
  const d=daysLeft(a.dueDate);
  return d<0?badge(`Overdue by ${-d}d`,'bad'):d===0?badge('Due today','warn'):d<=3?badge(`${d}d left`,'warn'):'';
}
function assignCard(a,sid,showClass=true){
  const st=statusOf(a.id,sid),s=subOf(a.id,sid);
  return `<article class="cardrow"><div class="mi">${ic('clip')}</div>
   <div class="grow"><div class="rt"><h4>${esc(a.title)}</h4>${badge(SL[st],SB[st])}${dueChip(a,st)}</div>
   <p class="muted" style="margin-top:2px">${esc(a.description)}</p>
   <p class="meta" style="margin-top:4px">Due ${fmtD(a.dueDate)} · ${STL[a.submissionType]}${showClass?` · ${esc(cls(a.classId).name)}`:''}${st==='graded'?` · Score <b>${s.score}/${a.maxScore}</b>`:''}</p></div>
   <div class="acts"><button class="btn sm ${st==='graded'||st==='submitted'?'':'prim'}" data-go="s-submit" data-p='${JSON.stringify({id:a.id})}'>${st==='graded'?'View feedback':st==='submitted'?'View submission':st==='in_progress'?'Continue':'Submit Assignment'}</button></div></article>`;
}
function noProgram(){return empty('You have not selected a program yet. Choose one to unlock your classes.',`<button class="btn prim" data-go="programs">Daftar Program</button>`)}
const upcoming=u=>classesFor(u).flatMap(c=>classAssigns(c.id)).filter(a=>!['submitted','graded'].includes(statusOf(a.id,u.id))).sort((a,b)=>a.dueDate.localeCompare(b.dueDate));
V['s-dash']=()=>{
  const u=me(),p=prog(u.selectedProgramId),cs=classesFor(u);
  if(!p)return ph(`Welcome, ${esc(first(u.name))}!`,'Let us find your program.')+noProgram();
  const up=upcoming(u).slice(0,4),rm=cs.flatMap(c=>visibleMats(c.id)).sort((a,b)=>b.date.localeCompare(a.date)).slice(0,4),pg=overall(u);
  return ph(`Welcome, ${esc(first(u.name))}!`,`Here is where you stand today.`)+`
  <div class="chead"><span class="eyebrow">Program</span><h1 style="margin-top:4px">${esc(p.name)}</h1><p>${esc(p.level)} · ${esc(p.duration)}</p>
   <div style="display:flex;justify-content:space-between;margin-top:14px"><span style="color:var(--hero-muted)">Overall progress</span><span class="pct">${pg}%</span></div>${bar(pg)}</div>
  <div class="grid two">
   <section class="card"><h3 style="font-size:20px;margin-bottom:6px">Your classes</h3>
    ${cs.map((c,i)=>`<div class="row"><span class="mi">${i+1}</span><div class="grow"><h4 style="font-size:16px">${esc(c.name)}</h4><div class="meta">Tutor ${esc(tutorName(c))} · ${esc(c.schedule)}</div>${bar(classProg(u.id,c.id))}</div><button class="btn sm" data-go="s-class" data-p='${JSON.stringify({id:c.id})}'>Open</button></div>`).join('')}</section>
   <section class="card"><h3 style="font-size:20px;margin-bottom:6px">Upcoming assignments</h3>
    ${up.length?up.map(a=>`<div class="row"><div class="grow"><h4 style="font-size:16px">${esc(a.title)}</h4><div class="meta">${esc(cls(a.classId).name)} · Due ${fmtD(a.dueDate,1)}</div></div>${dueChip(a,statusOf(a.id,u.id))}<button class="btn sm prim" data-go="s-submit" data-p='${JSON.stringify({id:a.id})}'>Open</button></div>`).join(''):empty('Nothing due. You are all caught up.')}</section>
  </div>
  <section class="card" style="margin-top:16px"><div class="rt" style="justify-content:space-between;margin-bottom:6px"><h3 style="font-size:20px">Recent materials</h3><button class="btn sm" data-go="s-materials">All materials</button></div>
   ${rm.length?`<div class="stack">${rm.map(m=>matRow(m,u.id,true)).join('')}</div>`:empty('No materials have been published yet.')}</section>`;
};
V['s-classes']=()=>{const u=me(),cs=classesFor(u);
  return ph('My Classes',u.selectedProgramId?`Program: <b>${esc(prog(u.selectedProgramId).name)}</b>`:'')+(cs.length?`<div class="grid">${cs.map(c=>classCard(c,u)).join('')}</div>`:noProgram())};
V['s-class']=()=>{
  const u=me(),c=cls(R.p.id);
  if(!c||c.programId!==u.selectedProgramId){setTimeout(()=>{toast('You do not have access to that class.');go('s-classes')},0);return ''}
  const tab=R.p.tab||'overview',pg=classProg(u.id,c.id),ms=visibleMats(c.id),as=classAssigns(c.id);
  const tabs=[['overview','Overview'],['materials','Materials'],['assignments','Assignments'],['discussions','Discussions'],['progress','Progress']];
  let body='';
  if(tab==='overview'){
    const nx=as.filter(a=>!['submitted','graded'].includes(statusOf(a.id,u.id))).sort((a,b)=>a.dueDate.localeCompare(b.dueDate))[0];
    body=`<div class="grid two"><div class="card"><h3 style="font-size:20px;margin-bottom:8px">About this class</h3><p>${esc(c.description)}</p>
      <div class="stack" style="margin-top:14px"><p class="meta">Tutor: <b>${esc(usr(c.tutorId).name)}</b></p><p class="meta">Schedule: <b>${esc(c.schedule)}</b></p><p class="meta">Level: <b>${esc(c.level)}</b> · ${esc(c.classType)}</p></div></div>
      <div class="card"><h3 style="font-size:20px;margin-bottom:8px">Next up</h3>${nx?`<h4 style="font-size:17px">${esc(nx.title)}</h4><p class="meta" style="margin:4px 0 12px">Due ${fmtD(nx.dueDate)} · ${STL[nx.submissionType]}</p><button class="btn prim" data-go="s-submit" data-p='${JSON.stringify({id:nx.id})}'>Open assignment</button>`:`<p class="muted">No pending assignments in this class.</p>`}</div></div>
      <h3 style="font-size:20px;margin:22px 0 10px">Latest materials</h3>${ms.length?`<div class="stack">${ms.slice(0,2).map(m=>matRow(m,u.id)).join('')}</div>`:empty('No materials yet.')}`;
  }else if(tab==='materials')body=ms.length?`<div class="stack">${ms.map(m=>matRow(m,u.id)).join('')}</div>`:empty('Your tutor has not published any materials yet.');
  else if(tab==='assignments')body=as.length?`<div class="stack">${as.map(a=>assignCard(a,u.id,false)).join('')}</div>`:empty('No assignments yet.');
  else if(tab==='discussions')body=discussionBlock(c.id,u);
  else{
    const doneM=ms.filter(m=>isDone(u.id,m.id)).length,graded=as.filter(a=>statusOf(a.id,u.id)==='graded');
    body=`<div class="stats"><div class="stat"><b>${pg}%</b><span>Class progress</span></div><div class="stat"><b>${doneM}/${ms.length}</b><span>Materials completed</span></div><div class="stat"><b>${as.filter(a=>['submitted','graded'].includes(statusOf(a.id,u.id))).length}/${as.length}</b><span>Assignments submitted</span></div></div>
     <div class="tablewrap"><table><thead><tr><th>Assignment</th><th>Status</th><th>Score</th></tr></thead><tbody>${as.map(a=>{const s=subOf(a.id,u.id),st=statusOf(a.id,u.id);return `<tr><td>${esc(a.title)}</td><td>${badge(SL[st],SB[st])}</td><td class="tnum">${st==='graded'?`${s.score}/${a.maxScore}`:'–'}</td></tr>`}).join('')}</tbody></table></div>`;
  }
  return `<div class="crumb"><button data-go="s-classes">My Classes</button> / <span>${esc(c.name)}</span></div>
   <div class="chead"><h1>${esc(c.name)}</h1><p>${esc(c.description)}</p><p style="margin-top:8px">Tutor ${esc(usr(c.tutorId).name)} · ${esc(c.schedule)}</p>
    <div style="display:flex;justify-content:space-between;margin-top:14px"><span style="color:var(--hero-muted)">Progress</span><span class="pct">${pg}%</span></div>${bar(pg)}</div>
   <div class="tabs" role="tablist">${tabs.map(t=>`<button role="tab" class="${t[0]===tab?'on':''}" data-act="tab" data-tab="${t[0]}">${t[1]}</button>`).join('')}</div>${body}`;
