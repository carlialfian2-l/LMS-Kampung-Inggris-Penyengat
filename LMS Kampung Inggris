};

/* ============ selectors ============ */
const me=()=>db.users.find(u=>u.id===db.session)||null;
const usr=id=>db.users.find(u=>u.id===id)||{name:'Unknown',av:0};
const prog=id=>db.programs.find(p=>p.id===id);
const cls=id=>db.classes.find(c=>c.id===id);
const progClasses=pid=>db.classes.filter(c=>c.programId===pid);
const classesFor=u=>u&&u.selectedProgramId?progClasses(u.selectedProgramId):[];
const tClasses=u=>db.classes.filter(c=>c.tutorId===u.id);
const visibleMats=cid=>db.materials.filter(m=>m.classId===cid&&m.published&&m.date<=todayS()).sort((a,b)=>b.date.localeCompare(a.date));
const classAssigns=cid=>db.assignments.filter(a=>a.classId===cid);
const isDone=(sid,mid)=>db.completions.some(c=>c.studentId===sid&&c.materialId===mid);
const subOf=(aid,sid)=>db.submissions.find(s=>s.assignmentId===aid&&s.studentId===sid);
const statusOf=(aid,sid)=>{const s=subOf(aid,sid);return s?s.status:'not_started'};
function classProg(sid,cid){
  const ms=visibleMats(cid),as=classAssigns(cid),tot=ms.length+as.length;if(!tot)return 0;
  const done=ms.filter(m=>isDone(sid,m.id)).length+as.filter(a=>['submitted','graded'].includes(statusOf(a.id,sid))).length;
  return Math.round(done/tot*100);
}
function overall(u){const cs=classesFor(u);return cs.length?Math.round(cs.reduce((t,c)=>t+classProg(u.id,c.id),0)/cs.length):0}
const studentsOfProgram=pid=>db.users.filter(u=>u.role==='student'&&u.selectedProgramId===pid);
