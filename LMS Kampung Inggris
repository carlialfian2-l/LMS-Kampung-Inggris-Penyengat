function discussionBlock(cid,u){
  const posts=db.discussions.filter(d=>d.classId===cid).sort((a,b)=>b.date.localeCompare(a.date));
  return `<div class="card"><form data-f="post" data-cid="${cid}"><div class="fld"><label for="dp">Post to the class</label><textarea id="dp" name="text" placeholder="Ask a question or share something useful" required style="min-height:80px"></textarea></div><button class="btn prim" type="submit">Post</button></form>
   <div style="margin-top:14px">${posts.map(p=>{const a=usr(p.authorId);return `<div class="post">${avatar(a)}<div class="grow"><div class="rt"><b>${esc(a.name)}</b>${a.role==='tutor'?badge('Tutor','sun'):''}<span class="meta">${fmtD(p.date,1)}</span></div><p>${esc(p.text)}</p></div></div>`}).join('')}</div></div>`;
}
V['s-materials']=()=>{
  const u=me(),cs=classesFor(u),f=R.p.cls||'all';
  const ms=cs.filter(c=>f==='all'||c.id===f).flatMap(c=>visibleMats(c.id)).sort((a,b)=>b.date.localeCompare(a.date));
  return ph('Materials','Everything your tutors have published.',cs.length?`<select data-change="cls" aria-label="Filter by class" style="width:auto"><option value="all">All classes</option>${cs.map(c=>`<option value="${c.id}" ${f===c.id?'selected':''}>${esc(c.name)}</option>`).join('')}</select>`:'')+
   (!cs.length?noProgram():ms.length?`<div class="stack">${ms.map(m=>matRow(m,u.id,true)).join('')}</div>`:empty('No published materials for this filter.'));
};
V['s-assign']=()=>{
  const u=me(),cs=classesFor(u),f=R.p.st||'all';
  const as=cs.flatMap(c=>classAssigns(c.id)).filter(a=>f==='all'||statusOf(a.id,u.id)===f).sort((a,b)=>a.dueDate.localeCompare(b.dueDate));
  return ph('Assignments','Submit work, then check grades and feedback.',cs.length?`<select data-change="st" aria-label="Filter by status" style="width:auto"><option value="all">All statuses</option>${Object.keys(SL).map(k=>`<option value="${k}" ${f===k?'selected':''}>${SL[k]}</option>`).join('')}</select>`:'')+
   (!cs.length?noProgram():as.length?`<div class="stack">${as.map(a=>assignCard(a,u.id)).join('')}</div>`:empty('No assignments match this filter.'));
};
V['s-submit']=()=>{
  const u=me(),a=db.assignments.find(x=>x.id===R.p.id),c=a&&cls(a.classId);
  if(!a||c.programId!==u.selectedProgramId){setTimeout(()=>{toast('You do not have access to that assignment.');go('s-assign')},0);return ''}
  const s=subOf(a.id,u.id),st=statusOf(a.id,u.id),locked=['submitted','graded'].includes(st);
