<title>Kampung Inggris</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,700&amp;family=Public+Sans:wght@400;500;600;700&amp;display=swap">
<style>
/* Layout: public marketing pages in a centered wrap; signed-in app is a sidebar + main shell that collapses to a drawer on phones. */
:root{
  --bg:#F3F6FB; --surface:#FFFFFF; --surface2:#EAF1FA; --line:#D8E2F0;
  --fg:#10203D; --muted:#566884;
  --brand:#0B2F6B; --brand-fg:#FFFFFF; --brand-ink:#0B2F6B;
  --sky:#D8E8FB; --sky-ink:#0B2F6B;
  --sun:#F5B82E; --sun-ink:#3A2700;
  --hero-bg:#0B2F6B; --hero-fg:#FFFFFF; --hero-muted:#BFD2EE;
  --good:#17724A; --good-bg:#DDF3E6; --warn:#7D5200; --warn-bg:#FFF0C7;
  --bad:#B3261E; --bad-bg:#FBE0DD; --info:#124A9E; --info-bg:#DCEBFF;
  --shadow:0 1px 2px rgba(11,47,107,.06),0 8px 24px rgba(11,47,107,.07);
  --font-display:'Bricolage Grotesque','Segoe UI',system-ui,sans-serif;
  --font-body:'Public Sans','Segoe UI',system-ui,sans-serif;
}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){
  --bg:#0A1220; --surface:#111C33; --surface2:#17274A; --line:#24365C;
  --fg:#E7EEFA; --muted:#9BAAC7;
  --brand:#2F6FD0; --brand-fg:#FFFFFF; --brand-ink:#8DBBFF;
  --sky:#1B2F57; --sky-ink:#BBD6FF;
  --hero-bg:#0F2A57; --hero-muted:#B5C9E8;
  --good:#6FD39B; --good-bg:#12332A; --warn:#F5C45B; --warn-bg:#3A2D0E;
  --bad:#FF9A92; --bad-bg:#3E1B19; --info:#9CC6FF; --info-bg:#16305C;
  --shadow:0 1px 2px rgba(0,0,0,.3),0 8px 24px rgba(0,0,0,.25);
  color-scheme:dark}}
:root[data-theme="dark"]{
  --bg:#0A1220; --surface:#111C33; --surface2:#17274A; --line:#24365C;
  --fg:#E7EEFA; --muted:#9BAAC7;
  --brand:#2F6FD0; --brand-fg:#FFFFFF; --brand-ink:#8DBBFF;
  --sky:#1B2F57; --sky-ink:#BBD6FF;
  --hero-bg:#0F2A57; --hero-muted:#B5C9E8;
  --good:#6FD39B; --good-bg:#12332A; --warn:#F5C45B; --warn-bg:#3A2D0E;
  --bad:#FF9A92; --bad-bg:#3E1B19; --info:#9CC6FF; --info-bg:#16305C;
  --shadow:0 1px 2px rgba(0,0,0,.3),0 8px 24px rgba(0,0,0,.25);
  color-scheme:dark}

*{box-sizing:border-box}
body{background:var(--bg);color:var(--fg);font:15px/1.55 var(--font-body);-webkit-font-smoothing:antialiased}
h1,h2,h3,h4{font-family:var(--font-display);line-height:1.15;margin:0;text-wrap:balance;letter-spacing:-.01em}
p{margin:0}
a{color:var(--brand-ink)}
button,input,select,textarea{font:inherit;color:inherit}
:focus-visible{outline:3px solid var(--sun);outline-offset:2px}
.ic{flex:none;display:inline-block;vertical-align:middle}
.muted{color:var(--muted)}
.wrap{max-width:1120px;margin-inline:auto;padding-inline:16px}
.grow{flex:1;min-width:0}
.tnum{font-variant-numeric:tabular-nums}

/* buttons */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:10px 16px;border-radius:10px;border:1px solid var(--line);background:var(--surface);cursor:pointer;font-weight:600;text-decoration:none;color:var(--fg);transition:transform .12s,background .12s}
.btn:hover{background:var(--surface2)}
.btn:active{transform:translateY(1px)}
.btn.prim{background:var(--brand);border-color:var(--brand);color:var(--brand-fg)}
.btn.prim:hover{filter:brightness(1.12)}
.btn.sun{background:var(--sun);border-color:var(--sun);color:var(--sun-ink)}
.btn.sun:hover{filter:brightness(1.05)}
.btn.sm{padding:6px 12px;font-size:13px;border-radius:8px}
.btn.danger{color:var(--bad)}
.btn.block{width:100%}
.btn.onhero{background:transparent;border-color:rgba(255,255,255,.45);color:#fff}
.btn.onhero:hover{background:rgba(255,255,255,.12)}

/* badges + bars */
.badge{display:inline-flex;align-items:center;gap:4px;padding:2px 9px;border-radius:99px;font-size:12px;font-weight:600;background:var(--surface2);color:var(--muted);white-space:nowrap}
.badge.info{background:var(--info-bg);color:var(--info)}
.badge.good{background:var(--good-bg);color:var(--good)}
.badge.warn{background:var(--warn-bg);color:var(--warn)}
.badge.bad{background:var(--bad-bg);color:var(--bad)}
.badge.sun{background:var(--sun);color:var(--sun-ink)}
.bar{height:8px;border-radius:99px;background:var(--surface2);overflow:hidden}
.bar>i{display:block;height:100%;border-radius:99px;background:var(--brand)}
.bar.sunbar>i{background:var(--sun)}
.pct{font-weight:700;font-variant-numeric:tabular-nums}

/* cards */
.card{background:var(--surface);border:1px solid var(--line);border-radius:16px;padding:20px;box-shadow:var(--shadow);min-width:0}
.card.flat{box-shadow:none}
.grid{display:grid;gap:16px;grid-template-columns:repeat(auto-fill,minmax(min(100%,270px),1fr))}
.grid.two{grid-template-columns:repeat(auto-fit,minmax(min(100%,340px),1fr))}
.stack{display:flex;flex-direction:column;gap:12px}
.row{display:flex;gap:12px;align-items:flex-start;padding:14px 0;border-top:1px solid var(--line)}
.row:first-child{border-top:0}
.cardrow{display:flex;gap:14px;align-items:flex-start;padding:16px;border:1px solid var(--line);background:var(--surface);border-radius:14px;flex-wrap:wrap}
.rt{display:flex;gap:8px;align-items:center;flex-wrap:wrap}
.rt h4{font-size:16px}
.meta{font-size:13px;color:var(--muted)}
.acts{display:flex;gap:8px;flex-wrap:wrap;align-items:center}
.mi{width:42px;height:42px;border-radius:12px;display:grid;place-items:center;background:var(--sky);color:var(--sky-ink);flex:none}
.mi.t-video{background:var(--bad-bg);color:var(--bad)}
.mi.t-audio{background:var(--warn-bg);color:var(--warn)}
.mi.t-link{background:var(--good-bg);color:var(--good)}
.empty{padding:28px 16px;text-align:center;color:var(--muted);border:1px dashed var(--line);border-radius:14px;display:flex;flex-direction:column;gap:12px;align-items:center}
.avatar{width:36px;height:36px;border-radius:50%;display:grid;place-items:center;font-weight:700;font-size:13px;color:#fff;flex:none}
.av0{background:#1D5FC4}.av1{background:#B4468A}.av2{background:#2E8B6A}.av3{background:#C2701A}.av4{background:#6A4FC2}.av5{background:#2A7F9C}

/* public */
.pnav{position:sticky;top:env(safe-area-inset-top,0px);z-index:20;background:var(--bg);border-bottom:1px solid var(--line)}
.pnav-in{display:flex;align-items:center;gap:12px;padding-block:12px;flex-wrap:wrap}
.pnav-links{display:flex;gap:4px;margin-left:auto;align-items:center;flex-wrap:wrap}
.pnav-links .lnk{background:none;border:0;cursor:pointer;padding:8px 10px;font-weight:600;color:var(--muted);border-radius:8px;text-decoration:none}
.pnav-links .lnk:hover{color:var(--fg)}
.brand{display:flex;align-items:center;gap:10px;text-decoration:none;color:var(--fg);font-family:var(--font-display);font-weight:700;font-size:19px}
.logo{width:34px;height:34px;border-radius:10px;background:var(--brand);color:var(--brand-fg);display:grid;place-items:center}
.logo .ic{color:var(--sun)}
.hero{background:var(--hero-bg);color:var(--hero-fg)}
.hero-in{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(0,.85fr);gap:40px;padding-block:56px 64px;align-items:center}
.eyebrow{font-size:12px;letter-spacing:.12em;text-transform:uppercase;font-weight:700;color:var(--sun)}
.hero h1{font-size:clamp(36px,6vw,62px);margin:12px 0 16px;letter-spacing:-.025em}
.hero h1 em{font-style:normal;color:var(--sun)}
.hero p.lead{color:var(--hero-muted);font-size:18px;max-width:52ch}
.hero .ctas{display:flex;gap:12px;flex-wrap:wrap;margin-top:28px}
.hero-card{background:var(--surface);color:var(--fg);border-radius:20px;padding:20px;box-shadow:0 20px 50px rgba(0,0,0,.28);transform:rotate(1.2deg)}
.hero-card .mini{margin-top:12px;border:1px solid var(--line);border-radius:12px;padding:12px;display:flex;gap:10px;align-items:center}
.section{padding-block:56px}
.section h2{font-size:clamp(26px,4vw,38px);margin-bottom:8px}
.section .sub{color:var(--muted);max-width:60ch;margin-bottom:28px}
.alt{background:var(--surface);border-block:1px solid var(--line)}
.steps{display:grid;gap:16px;grid-template-columns:repeat(auto-fit,minmax(min(100%,220px),1fr));counter-reset:s}
.step{position:relative;padding:20px;border-radius:16px;background:var(--bg);border:1px solid var(--line)}
.step::before{counter-increment:s;content:counter(s);display:grid;place-items:center;width:32px;height:32px;border-radius:50%;background:var(--sun);color:var(--sun-ink);font-weight:700;margin-bottom:12px}
.step h4{margin-bottom:6px}
.footer{padding-block:28px;border-top:1px solid var(--line);color:var(--muted);font-size:13px}
.pcard{display:flex;flex-direction:column;gap:12px}
.pcard h3{font-size:22px}
.pcard ul{margin:0;padding:0;list-style:none;display:flex;flex-direction:column;gap:6px}
.pcard li{display:flex;gap:8px;align-items:center;font-size:14px}
.pcard li .ic{color:var(--brand-ink)}
.chips{display:flex;gap:6px;flex-wrap:wrap}
.pcard .foot{margin-top:auto;padding-top:8px}
.crumb{display:flex;gap:6px;align-items:center;font-size:13px;color:var(--muted);margin-bottom:16px;flex-wrap:wrap}
.crumb button{background:none;border:0;cursor:pointer;color:var(--brand-ink);padding:0;font-weight:600}
.authbox{max-width:440px;margin:40px auto;padding-inline:16px}
.divider{display:flex;align-items:center;gap:12px;color:var(--muted);font-size:13px;margin:16px 0}
.divider::before,.divider::after{content:"";height:1px;background:var(--line);flex:1}
.demo{display:flex;gap:8px;flex-wrap:wrap}
.pick{display:grid;gap:16px;grid-template-columns:repeat(auto-fit,minmax(min(100%,200px),1fr))}
.pick button{display:flex;flex-direction:column;gap:10px;align-items:flex-start;text-align:left;padding:20px;border:2px solid var(--line);border-radius:16px;background:var(--surface);cursor:pointer}
.pick button:hover{border-color:var(--brand)}
.pick button .mi{width:46px;height:46px}

/* forms */
label{display:block;font-weight:600;font-size:13px;margin-bottom:6px}
.fld{margin-bottom:14px;min-width:0}
input[type=text],input[type=email],input[type=password],input[type=number],input[type=date],input[type=url],select,textarea{width:100%;padding:10px 12px;border:1px solid var(--line);border-radius:10px;background:var(--surface);min-width:0}
textarea{min-height:110px;resize:vertical}
input[type=file]{width:100%;padding:8px;border:1px dashed var(--line);border-radius:10px;background:var(--bg)}
.frow{display:grid;gap:14px;grid-template-columns:repeat(auto-fit,minmax(min(100%,220px),1fr))}
.check{display:flex;gap:8px;align-items:center;font-weight:500}
.check input{width:18px;height:18px}
.hint{font-size:12px;color:var(--muted);margin-top:4px}

/* app shell */
.shell{display:grid;grid-template-columns:264px minmax(0,1fr);min-height:100dvh}
.side{background:var(--surface);border-right:1px solid var(--line);padding:18px 12px;display:flex;flex-direction:column;gap:4px;position:sticky;top:0;height:100dvh;overflow-y:auto}
.side .brand{padding:4px 8px 16px}
.side .who{display:flex;gap:10px;align-items:center;padding:10px 8px;margin-bottom:8px;border-radius:12px;background:var(--surface2)}
.nav{display:flex;align-items:center;gap:10px;padding:10px 12px;border-radius:10px;border:0;background:none;cursor:pointer;text-align:left;font-weight:600;color:var(--muted);width:100%;text-decoration:none}
.nav:hover{background:var(--surface2);color:var(--fg)}
.nav.on{background:var(--brand);color:var(--brand-fg)}
.nav.out{margin-top:auto}
.main{padding:24px 16px 64px;min-width:0;max-width:1100px;width:100%}
.topbar{display:none}
.scrim{display:none}
.ph{display:flex;gap:12px;align-items:flex-start;justify-content:space-between;flex-wrap:wrap;margin-bottom:20px}
.ph h1{font-size:clamp(24px,4vw,32px)}
.stats{display:grid;gap:12px;grid-template-columns:repeat(auto-fit,minmax(min(100%,160px),1fr));margin-bottom:20px}
.stat{background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:14px 16px}
.stat b{display:block;font:700 28px var(--font-display);font-variant-numeric:tabular-nums}
.stat span{font-size:13px;color:var(--muted)}
.tabs{display:flex;gap:4px;overflow-x:auto;border-bottom:1px solid var(--line);margin-bottom:20px}
.tabs button{background:none;border:0;border-bottom:3px solid transparent;padding:10px 14px;cursor:pointer;font-weight:600;color:var(--muted);white-space:nowrap}
.tabs button.on{color:var(--brand-ink);border-color:var(--sun)}
.chead{background:var(--hero-bg);color:var(--hero-fg);border-radius:18px;padding:22px;margin-bottom:20px}
.chead h1{font-size:clamp(24px,4vw,34px)}
.chead p{color:var(--hero-muted);margin-top:6px;max-width:64ch}
.chead .bar{background:rgba(255,255,255,.2);margin-top:14px}
.chead .bar>i{background:var(--sun)}
.tablewrap{overflow-x:auto;border:1px solid var(--line);border-radius:14px;background:var(--surface)}
table{border-collapse:collapse;width:100%;min-width:640px}
th,td{padding:12px 14px;text-align:left;border-bottom:1px solid var(--line);font-size:14px}
th{font-size:12px;text-transform:uppercase;letter-spacing:.06em;color:var(--muted);background:var(--surface2)}
tr:last-child td{border-bottom:0}
.post{display:flex;gap:12px;padding:14px 0;border-top:1px solid var(--line)}
.post:first-child{border-top:0}
.sub-box{white-space:pre-wrap;background:var(--bg);border:1px solid var(--line);border-radius:12px;padding:14px}

/* overlays */
.modal-back{position:fixed;inset:0;background:rgba(5,12,28,.55);display:grid;place-items:center;padding:16px;z-index:60}
.modal{background:var(--surface);color:var(--fg);border-radius:18px;padding:22px;max-width:480px;width:100%;box-shadow:0 24px 60px rgba(0,0,0,.35)}
.modal h3{margin-bottom:8px}
.preview{display:grid;place-items:center;gap:8px;padding:28px;background:var(--surface2);border-radius:14px;margin:12px 0;text-align:center}
#toast{position:fixed;left:50%;transform:translateX(-50%);bottom:calc(20px + env(safe-area-inset-bottom,0px));background:var(--fg);color:var(--bg);padding:10px 18px;border-radius:12px;font-weight:600;z-index:80;max-width:calc(100% - 32px);box-shadow:var(--shadow)}

@media (max-width:900px){
  .hero-in{grid-template-columns:minmax(0,1fr);padding-block:36px 44px}
  .hero-card{transform:none}
  .shell{grid-template-columns:minmax(0,1fr)}
  .topbar{display:flex;align-items:center;gap:12px;padding:10px 16px;background:var(--surface);border-bottom:1px solid var(--line);position:sticky;top:env(safe-area-inset-top,0px);z-index:30}
  .topbar .burger{background:none;border:0;cursor:pointer;padding:6px;border-radius:8px}
  .side{position:fixed;left:0;top:0;bottom:0;width:280px;max-width:86vw;z-index:50;transform:translateX(-102%);transition:transform .2s;padding-top:calc(18px + env(safe-area-inset-top,0px))}
  .side.open{transform:none;box-shadow:var(--shadow)}
  .scrim.on{display:block;position:fixed;inset:0;background:rgba(5,12,28,.45);z-index:40}
  .main{padding-top:20px}
}
@media (prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}}
</style>

