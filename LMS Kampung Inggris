/* ============ auth adapter (replace bodies with Supabase/Firebase calls) ============ */
const Auth={
  signUpEmail({name,email,password}){
    if(db.users.some(u=>u.email.toLowerCase()===email.toLowerCase()))throw new Error('That email already has an account. Log in instead.');
    const u={id:uid('u'),name,email,role:null,selectedProgramId:null,av:Math.floor(Math.random()*6)};
    db.users.push(u);return u;
  },
  signInEmail({email,password}){
    const u=db.users.find(x=>x.email.toLowerCase()===email.toLowerCase());
    if(!u)throw new Error('No account found for that email. Sign up first.');
    if(!password)throw new Error('Enter your password.');
    return u;
  },
  signInGoogle(){ /* mock: replace with OAuth popup / redirect */
    const email='google.learner@gmail.com';
    return db.users.find(x=>x.email===email)||(db.users.push({id:uid('u'),name:'Google Learner',email,role:null,selectedProgramId:null,av:5}),db.users[db.users.length-1]);
