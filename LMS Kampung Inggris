    <div class="meta" style="margin-bottom:6px">Assignment: ${esc(a.description)}</div><div class="sub-box">${esc(s.content)||'<span class="muted">No text answer.</span>'}</div>${s.fileName?`<p class="meta" style="margin-top:10px">${ic('file',14)} Attached: <b>${esc(s.fileName)}</b></p>`:''}</div>
   <div class="card"><form data-f="grade" data-id="${s.id}" novalidate>
    <div class="fld"><label for="gs">Score (max ${a.maxScore})</label><input id="gs" name="score" type="number" min="0" max="${a.maxScore}" value="${s.score??''}"></div>
    <div class="fld"><label for="gf">Feedback</label><textarea id="gf" name="feedback" placeholder="What went well and what to improve">${esc(s.feedback)}</textarea></div>
    <div class="fld"><label for="gt">Status</label><select id="gt" name="status">${['in_progress','submitted','graded'].map(k=>`<option value="${k}" ${(s.status===k||(s.status==='submitted'&&k==='graded'&&false))?'selected':''}>${SL[k]}</option>`).join('')}</select><p class="hint">Saving a score with status Graded releases the grade to the student. In Progress returns the work for revision.</p></div>
    <div class="acts"><button class="btn prim" type="submit">Save grade</button><button type="button" class="btn" data-go="t-subs">Cancel</button></div></form></div></div>`;
};
V['t-students']=()=>{
  const u=me(),cs=tClasses(u),pids=[...new Set(cs.map(c=>c.programId))],st=db.users.filter(x=>x.role==='student'&&pids.includes(x.selectedProgramId));
  return ph('Students','Students enrolled in the programs you teach in.')+(st.length?`<div class="tablewrap"><table><thead><tr><th>Student</th><th>Program</th><th>Your classes</th><th>Progress</th></tr></thead><tbody>${st.map(s=>{const mine=cs.filter(c=>c.programId===s.selectedProgramId),pg=Math.round(mine.reduce((t,c)=>t+classProg(s.id,c.id),0)/mine.length);return `<tr><td><div class="rt">${avatar(s)}<div><b>${esc(s.name)}</b><div class="meta">${esc(s.email)}</div></div></div></td><td>${esc(prog(s.selectedProgramId).name)}</td><td>${mine.map(c=>esc(c.name)).join(', ')}</td><td style="min-width:130px"><span class="pct">${pg}%</span>${bar(pg)}</td></tr>`}).join('')}</tbody></table></div>`:empty('No students are enrolled yet.'));
};
V['t-profile']=()=>{
  const u=me(),cs=tClasses(u);
  return ph('Profile')+`<div class="card" style="max-width:560px"><div class="rt" style="margin-bottom:14px">${avatar(u,52)}<div><h3 style="font-size:20px">${esc(u.name)}</h3><div class="meta">${esc(u.email)} · Tutor · ${cs.length} class${cs.length===1?'':'es'}</div></div></div>
   <form data-f="profile"><div class="fld"><label for="pn">Full name</label><input id="pn" name="name" type="text" value="${esc(u.name)}" required></div><div class="acts"><button class="btn prim" type="submit">Save changes</button><button type="button" class="btn" data-act="logout">${ic('logout',16)}Logout</button></div></form></div>`;
};

/* ============ render ============ */
function render(){
  const u=me(),fn=V[R.name]||V.landing,html=fn(),app=document.getElementById('app');
  app.innerHTML=PUBLIC.includes(R.name)||R.name==='role'?html:appShell(u,html);
}
function modal(html){document.getElementById('modal').innerHTML=html?`<div class="modal-back" data-act="close-modal"><div class="modal" role="dialog" aria-modal="true">${html}</div></div>`:''}
let confirmFn=null;
function ask(title,msg,label,fn){confirmFn=fn;modal(`<h3>${esc(title)}</h3><p class="muted">${esc(msg)}</p><div class="acts" style="margin-top:16px;justify-content:flex-end"><button class="btn" data-act="close-modal">Cancel</button><button class="btn prim" data-act="confirm-yes">${esc(label)}</button></div>`)}

/* ============ actions ============ */
const H={
 'open-menu'(){document.querySelector('.side').classList.add('open');document.querySelector('.scrim').classList.add('on')},
 'close-menu':closeMenu,
 'close-modal'(el,e){if(e.target===el||el.tagName==='BUTTON')modal('')},
 'confirm-yes'(){const f=confirmFn;confirmFn=null;modal('');f&&f()},
 logout(){Auth.signOut();save();toast('Logged out.');go('landing')},
 google(){try{afterAuth(Auth.signInGoogle())}catch(e){toast(e.message)}},
 demo(el){try{afterAuth(Auth.signInEmail({email:el.dataset.email,password:'demo'}))}catch(e){toast(e.message)}},
 register(el){
  const id=el.dataset.id,u=me();db.pending=id;save();
  if(!u)return go('signup');
  if(u.role==='tutor')return toast('Tutors cannot enroll in programs. Log out to sign up as a student.');
  if(!u.role)return go('role');
  u.selectedProgramId=id;syncEnroll(u);save();toast(`Enrolled in ${prog(id).name}.`);go('s-dash');
 },
 role(el){
  const u=me(),r=el.dataset.role;u.role=r;
  if(r==='student'){if(db.pending){u.selectedProgramId=db.pending}syncEnroll(u)}
  db.pending=null;save();toast(r==='student'?'Welcome, student!':'Welcome, tutor!');go(homeOf(u));
 },
 tab(el){R.p.tab=el.dataset.tab;render()},
 'view-mat'(el){
  const m=db.materials.find(x=>x.id===el.dataset.id);
  modal(`<h3>${esc(m.title)}</h3><div class="meta">${TL[m.type]} · ${fmtD(m.date,1)}</div><div class="preview">${ic(TI[m.type],34)}<b>${esc(m.fileName||m.fileUrl||TL[m.type])}</b><span class="meta">Preview is simulated in this prototype.</span></div><p class="muted">${esc(m.description)}</p>
   <div class="acts" style="margin-top:16px;justify-content:flex-end">${m.type==='link'&&m.fileUrl?`<a class="btn prim" href="${esc(m.fileUrl)}" target="_blank" rel="noopener">Open link</a>`:''}<button class="btn" data-act="close-modal">Close</button></div>`);
 },
 'dl-mat'(el){const m=db.materials.find(x=>x.id===el.dataset.id);toast(m.type==='link'?'This is a link. Use View to open it.':`Download started for ${m.fileName||m.title} (simulated).`)},
 'complete-mat'(el){
  const u=me(),id=el.dataset.id,i=db.completions.findIndex(c=>c.studentId===u.id&&c.materialId===id);
  if(i>=0)db.completions.splice(i,1);else db.completions.push({studentId:u.id,materialId:id});
  save();render();toast(i>=0?'Marked as not completed.':'Marked as completed.');
 },
 'toggle-pub'(el){const m=db.materials.find(x=>x.id===el.dataset.id);m.published=!m.published;save();render();toast(m.published?'Material published.':'Material unpublished.')},
 'del-mat'(el){const id=el.dataset.id,m=db.materials.find(x=>x.id===id);ask('Delete material?',`"${m.title}" will be removed for you and your students.`,'Delete',()=>{db.materials=db.materials.filter(x=>x.id!==id);db.completions=db.completions.filter(c=>c.materialId!==id);save();render();toast('Material deleted.')})},
 'del-assign'(el){const id=el.dataset.id,a=db.assignments.find(x=>x.id===id);ask('Delete assignment?',`"${a.title}" and all of its submissions will be removed.`,'Delete',()=>{db.assignments=db.assignments.filter(x=>x.id!==id);db.submissions=db.submissions.filter(s=>s.assignmentId!==id);save();render();toast('Assignment deleted.')})}
};
const F={
 login(d){try{afterAuth(Auth.signInEmail({email:d.email.trim(),password:d.password}))}catch(e){toast(e.message)}},
 signup(d){
  if(!d.name.trim()||!d.email.trim())return toast('Enter your name and email.');
  if(d.password.length<6)return toast('Password must be at least 6 characters.');
  if(d.password!==d.confirm)return toast('Passwords do not match.');
  try{afterAuth(Auth.signUpEmail({name:d.name.trim(),email:d.email.trim(),password:d.password}))}catch(e){toast(e.message)}
 },
 post(d,f){const u=me();if(!d.text.trim())return;db.discussions.push({id:uid('d'),classId:f.dataset.cid,authorId:u.id,text:d.text.trim(),date:todayS()});save();render();toast('Posted.')},
 profile(d){
  const u=me();if(!d.name.trim())return toast('Name cannot be empty.');
  u.name=d.name.trim();
  if(u.role==='student'&&'program' in d){u.selectedProgramId=d.program||null;syncEnroll(u)}
  save();render();toast('Profile saved.');
 },
 submit(d,f,e){
  const u=me(),a=db.assignments.find(x=>x.id===f.dataset.aid),mode=(e.submitter&&e.submitter.value)||'submit';
  let s=subOf(a.id,u.id);const file=f.elements.file&&f.elements.file.files[0];
  const fileName=file?file.name:(s?s.fileName:'');
  if(mode==='submit'){
    if(a.submissionType==='text'&&!d.content.trim())return toast('Write your answer before submitting.');
    if(a.submissionType!=='text'&&!fileName)return toast('Upload a file before submitting.');
  }
  if(!s){s={id:uid('s'),assignmentId:a.id,studentId:u.id,score:null,feedback:''};db.submissions.push(s)}
  Object.assign(s,{content:d.content||'',fileName,status:mode==='submit'?'submitted':'in_progress',submittedAt:todayS()});
  save();render();toast(mode==='submit'?'Assignment submitted.':'Draft saved.');
 },
 'class-new'(d){
  const u=me();
  const c={id:uid('c'),programId:d.programId,tutorId:u.id,name:d.name.trim(),description:d.description.trim(),schedule:d.schedule.trim(),level:d.level,max:Math.max(1,parseInt(d.max)||20),classType:d.classType};
  if(!c.name||!c.schedule)return toast('Enter a class name and schedule.');
  db.classes.push(c);
  db.users.filter(x=>x.role==='student'&&x.selectedProgramId===c.programId).forEach(s=>syncEnroll(s));
  save();toast(`Class created in ${prog(c.programId).name}.`);go('t-class',{id:c.id});
 },
 material(d,f){
  const u=me(),id=f.dataset.id,file=f.elements.file.files[0],type=d.type;
  if(!d.title.trim())return toast('Enter a title.');
  if(type==='link'&&!d.fileUrl.trim())return toast('Add the external link for a Link material.');
  const ex=id?db.materials.find(x=>x.id===id):null;
  const rec={title:d.title.trim(),description:d.description.trim(),classId:d.classId,type,fileName:file?file.name:(ex?ex.fileName:''),fileUrl:d.fileUrl.trim(),published:'published' in d,date:d.date||todayS()};
  if(type!=='link'&&!rec.fileName&&!rec.fileUrl)return toast('Upload a file or add a link.');
  if(ex)Object.assign(ex,rec);else db.materials.push(Object.assign({id:uid('m'),tutorId:u.id},rec));
  save();toast(ex?'Material updated.':'Material added.');go('t-materials');
 },
 assign(d){
  const u=me();if(!d.title.trim()||!d.description.trim())return toast('Enter a title and description.');
  db.assignments.push({id:uid('a'),classId:d.classId,tutorId:u.id,title:d.title.trim(),description:d.description.trim(),dueDate:d.dueDate,submissionType:d.submissionType,maxScore:Math.max(1,parseInt(d.maxScore)||100)});
  save();toast('Assignment created.');go('t-assign');
 },
 grade(d,f){
  const s=db.submissions.find(x=>x.id===f.dataset.id),a=db.assignments.find(x=>x.id===s.assignmentId);
  const hasScore=d.score!==''&&d.score!==undefined,score=hasScore?Number(d.score):null;
  if(d.status==='graded'&&!hasScore)return toast('Enter a score to mark this as graded.');
  if(hasScore&&(score<0||score>a.maxScore))return toast(`Score must be between 0 and ${a.maxScore}.`);
  Object.assign(s,{score,feedback:d.feedback.trim(),status:d.status});
  save();toast(d.status==='graded'?'Grade released to the student.':'Submission updated.');go('t-subs');
 }
};

document.addEventListener('click',e=>{
  const g=e.target.closest('[data-go]');
  if(g){e.preventDefault();let p={};try{p=g.dataset.p?JSON.parse(g.dataset.p):{}}catch(x){}return go(g.dataset.go,p)}
  const a=e.target.closest('[data-act]');
  if(a&&H[a.dataset.act]){
    if(a.dataset.act==='close-modal'&&a.classList.contains('modal-back')&&e.target!==a)return;
    H[a.dataset.act](a,e);
  }
});
document.addEventListener('submit',e=>{
  const f=e.target.closest('form[data-f]');if(!f)return;e.preventDefault();
  const d=Object.fromEntries([...new FormData(f).entries()].filter(x=>typeof x[1]==='string'));
  const h=F[f.dataset.f];if(h)h(d,f,e);
});
document.addEventListener('change',e=>{
  const s=e.target.closest('[data-change]');if(!s)return;
  R.p=Object.assign({},R.p,{[s.dataset.change]:s.value});render();
});
document.addEventListener('keydown',e=>{if(e.key==='Escape'){modal('');closeMenu()}});

render();
</script>

</body>
